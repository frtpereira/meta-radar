{
    "swagger": "2.0",
    "info": {
        "description": "API for tracking Pokemon TCG tournaments, decklists, archetypes and matchup statistics.",
        "title": "Meta Radar API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/archetypes/stats": {
            "get": {
                "description": "Returns per-archetype play counts, average standing, and win/score rates for a given meta.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "archetypes"
                ],
                "summary": "Archetype stats for a meta",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Meta UUID",
                        "name": "meta_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/apidocs.ArchetypeStat"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/archetypes/{id}": {
            "get": {
                "description": "Returns an archetype's metadata plus its computed core card list.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "archetypes"
                ],
                "summary": "Get archetype detail",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Archetype ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/apidocs.ArchetypeDetail"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/archetypes/{id}/card-stats": {
            "get": {
                "description": "Returns per-card usage statistics (presence rate, copy-count distribution, modal count) for every decklist in an archetype.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "archetypes"
                ],
                "summary": "Archetype card stats",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Archetype ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/apidocs.CardStat"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/archetypes/{id}/variants": {
            "get": {
                "description": "Groups an archetype's decklists by core_hash into distinct build variants. Requires cmd/cluster to have run.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "archetypes"
                ],
                "summary": "List archetype variants",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Archetype ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/apidocs.Variant"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/matchups/stats": {
            "get": {
                "description": "Returns paginated, directional archetype-vs-archetype matchup results for a meta.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "matchups"
                ],
                "summary": "Archetype matchup stats",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Meta UUID",
                        "name": "meta_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Minimum number of matches required to include a matchup (default 20)",
                        "name": "min_matches",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter to matchups involving this archetype ID",
                        "name": "archetype_id",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include mirror matchups (default true)",
                        "name": "include_mirrors",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page size, max 100 (default 20)",
                        "name": "page_size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/apidocs.MatchupsResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/metas": {
            "get": {
                "description": "Lists all known metas (format eras) ordered by start date descending.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "metas"
                ],
                "summary": "List metas",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Meta"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/tournaments": {
            "get": {
                "description": "Lists tournaments, optionally filtered by minimum player count, format, and meta.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tournaments"
                ],
                "summary": "List tournaments",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Minimum number of players",
                        "name": "min_players",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Format code (e.g. STANDARD)",
                        "name": "format",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Meta UUID to filter by",
                        "name": "meta_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page size, max 100 (default 20)",
                        "name": "page_size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/apidocs.TournamentsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/tournaments/{id}": {
            "get": {
                "description": "Returns a tournament's metadata plus its full standings (player, archetype, match record).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tournaments"
                ],
                "summary": "Get tournament detail",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tournament ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/apidocs.TournamentDetail"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/webhooks/limitless": {
            "post": {
                "description": "Receives tournament update events from Limitless TCG and triggers an async sync of the affected tournament.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhooks"
                ],
                "summary": "Limitless tournament webhook",
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Reports whether the API is up.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
