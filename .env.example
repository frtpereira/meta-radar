DB_NAME=pokemontcg
DB_USER=app
DB_PASSWORD=devpassword

# Only required for the /games/{id}/decks endpoint on Limitless's API
LIMITLESS_API_KEY=

# Shared secret Limitless sends with each webhook call, once you register one
WEBHOOK_SECRET=

# Token for the Cloudflare Tunnel that exposes this app (Zero Trust dashboard
# > Networks > Tunnels > <tunnel> > Configure > "Install and run a connector").
# Required by `make tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

R2_BUCKET=
R2_ACCOUNT_ID=
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# UTC time of day the snapshot-scheduler service takes its daily (and,
# on Mondays, weekly) meta snapshot. Defaults to 06:00 if unset -- see
# backend/cmd/snapshot.
SNAPSHOT_AT=06:00