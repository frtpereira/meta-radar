DB_NAME=pokemontcg
DB_USER=app
DB_PASSWORD=devpassword

# Only required for the /games/{id}/decks endpoint on Limitless's API
LIMITLESS_API_KEY=

# Shared secret Limitless sends with each webhook call, once you register one
WEBHOOK_SECRET=

# Enable HTTPS on the API server by pointing these at a certificate/key pair
# mounted into the api container (docker-compose mounts ./certs at /certs).
# Run `make certs` to generate a self-signed pair for local dev at
# ./certs/server.crt and ./certs/server.key. Leave both blank to serve plain
# HTTP. See the "HTTPS" section in README.md for details.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Port the api container exposes on the host. Change to 8443 (or similar)
# once TLS is enabled above, since browsers expect HTTPS on a distinct port.
API_PORT=8080
